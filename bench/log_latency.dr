$svcs := qw(auth db api cache)
$n := 200000
$seed := 12345
$counts := {}
$sums := {}
for $s in $svcs {
	$counts[$s] = 0
	$sums[$s] = 0
}
for $i in 1..$n {
	$seed = ($seed * 1103515245 + 12345) % 2147483648
	$svc := $svcs[$seed % 4]
	$latency := $seed % 2000
	$line := "service=" ~ $svc ~ " latency=" ~ str($latency) ~ "ms"  # lint:ignore err-output
	$parts := split($line, " ")
	$svc2 := split($parts[0], "=")[1]
	$latstr := split($parts[1], "=")[1]
	$latnum := int(replace_all($latstr, "ms", ""))
	$counts[$svc2] = $counts[$svc2] + 1
	$sums[$svc2] = $sums[$svc2] + $latnum
}
for $s in $svcs {
	say($s, $counts[$s], $sums[$s])
}
