$n := 200000
$seed := 12345
$sum := 0
for $i in 1..$n {
	$seed = ($seed * 1103515245 + 12345) % 2147483648
	$a := $seed % 1000
	$seed = ($seed * 1103515245 + 12345) % 2147483648
	$b := $seed % 1000
	$seed = ($seed * 1103515245 + 12345) % 2147483648
	$c := $seed % 1000
	$line := "k1=" ~ str($a) ~ " k2=" ~ str($b) ~ " k3=" ~ str($c)  # lint:ignore err-output
	$tokens := split($line, " ")
	$map := {}
	for $tok in $tokens {
		$kv := split($tok, "=")
		$map[$kv[0]] = $kv[1]
	}
	$sum = $sum + int($map["k2"])
}
say($sum)
