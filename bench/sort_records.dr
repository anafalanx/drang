$n := 100000
$recs := []
$seed := 999
# Fixed-size setup remains below the collection cap; keep propagation overhead out of this benchmark.
for $i in 1..$n {
	$seed = ($seed * 1103515245 + 12345) % 2147483648
	push($recs, {id: $i, key: $seed % 100000})  # lint:ignore err-discard
}
$sorted := sort_by($recs, |$r| $r.key)
say($sorted[0].key + $sorted[$n - 1].key)
