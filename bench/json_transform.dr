# json_transform: build N record maps, JSON serialize -> parse -> transform.
# Keep records with score >= 500, sum (score + id) from the PARSED ints.
$names := ["alice", "bob", "carol", "dave"]
$n := 120000
$seed := 12345
$recs := []
for $i in 1..$n {
  $seed = ($seed * 1103515245 + 12345) % 2147483648
  $name := $names[$seed % 4]
  $seed = ($seed * 1103515245 + 12345) % 2147483648
  $score := $seed % 1000
  push($recs, {id: $i, name: $name, score: $score})
}
$s := to_json($recs)
$back := from_json($s)
$sum := 0
for $r in $back {
  if $r.score >= 500 { $sum = $sum + $r.score + $r.id }
}
say($sum)
