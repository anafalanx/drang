# grep_extract: regex filter + capture-group extraction over synthetic log lines.
# Per iteration the LCG picks a level and a code; only ERROR lines match the
# regex, and we sum their captured codes.
$levels := ["INFO", "WARN", "ERROR", "DEBUG"]
$rx := qr/^ERROR code=(\d+)/
$seed := 123456789
$matchCount := 0
$codeSum := 0
for $i in 1..300000 {
  $seed = ($seed * 1103515245 + 12345) % 2147483648
  $level := $levels[$seed % 4]
  $code := $seed % 1000
  $line := $level ~ " code=" ~ str($code)
  if matches($line, $rx) {
    $m := match($line, $rx)
    $codeSum = $codeSum + int($m[1])
    $matchCount = $matchCount + 1
  }
}
say($matchCount, $codeSum)
