# str_template: report formatting / string generation benchmark
$names := ["alice", "bob", "carol", "dave", "eve"]
$n := 200000
$seed := 12345
$total := 0
for $i in 1..$n {
	$seed = ($seed * 1103515245 + 12345) % 2147483648
	$name := $names[$seed % 5]
	$seed = ($seed * 1103515245 + 12345) % 2147483648
	$amount := $seed % 10000
	$line := "#" ~ str($i) ~ " " ~ $name ~ ": $" ~ str($amount) ~ ".00"  # lint:ignore err-output
	$total = $total + len($line)
}
say($total)
