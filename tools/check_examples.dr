# check_examples.dr — verify every runnable example in a Markdown doc against the
# interpreter. drang checking its own manual.
#
#   drang tools/check_examples.dr              # checks MANUAL.md
#   drang tools/check_examples.dr REFERENCE.md
#
# Run from the repo root. A runnable example is a ```drang fenced block; when it is
# followed (allowing blank lines) by a plain ``` block, that block is its expected
# output. The output is compared with the declared stream after CRLF/outer-whitespace
# normalization. A fence may carry explicit checker metadata:
#
#   ```drang exit=1 stream=stderr   # expected non-zero outcome and output stream
#   ```drang stream=combined        # stdout followed by stderr
#   ```drang nondeterministic       # run and require exit 0, but do not compare output
#   ```drang norun                  # display-only/context-dependent example
#
# Defaults are exit=0 and stream=stdout. An unexplained non-zero exit is therefore a
# failure, including for a block with no shown output.
#
#   - Non-deterministic examples must opt in with the fence metadata above. They are
#     run and must succeed, but their output legitimately is not compared.
#   - Shell-invocation examples (drang -ne '…', printf | drang) document command-line
#     usage, not a drang program, so they are skipped.
#   - A ```drang block with no shown output is run only to surface an unexpected abort.
#
# Each checker run uses a fresh system temporary directory shared by its examples,
# so concurrent checks do not collide and side effects stay contained. It is removed at the end.
$doc := $ARGV[0] // "MANUAL.md"
$src := read_file($doc)?
$lines := split(replace_all($src, "\r\n", "\n"), "\n")
$n := len($lines)?
$work ::= tempdir("drang-examples")?
$prog ::= path_join($work, "prog.dr")

fn .norm($s) {
	trim(replace_all($s, "\r", ""))
}

fn .first_code_line($code) {
	for $l in split($code, "\n") {
		$t := trim($l)?
		if $t != "" {
			$comment := starts_with($t, "#")?
			if !$comment {
				return $t
			}
		}
	}
	""
}

# A block whose first non-empty line is a `# norun` comment is shown, not run —
# for examples that would block or need a display (a serve() call opens a window
# and waits on it). The marker stays visible in the rendered manual, telling the
# reader why this one is not auto-verified.
fn .is_norun($code) {
	for $l in split($code, "\n") {
		if trim($l) != "" {
			return starts_with(trim($l), "# norun")?
		}
	}
	false
}

# A shell-invocation example documents command-line usage, not a drang program.
fn .is_shell($code) {
	$first := .first_code_line($code)?
	for $p in ["drang ", "printf ", "echo ", "$ "] {
		if starts_with($first, $p)? {
			return true
		}
	}
	$pipe := contains($code, "| drang")?
	$and := contains($code, "&& drang")?
	$pipe or $and
}

# Parse the optional words after ```drang. Unknown or malformed metadata is a gate
# failure rather than a silently ignored typo.
fn .meta($fence) {
	$m := {exit: 0, stream: "stdout", nondeterministic: false, norun: false, error: ""}
	$tail := trim(replace_first(trim($fence), "```drang", ""))
	if $tail == "" {
		return $m
	}
	for $word in split($tail, " ") {
		if $word == "" {
			next
		}
		if starts_with($word, "exit=")? {
			$v := int(replace_first($word, "exit=", ""))
			if is_err($v) or $v < 0 or $v > 255 {
				$m.error = "bad exit metadata " ~ $word ~ " (want exit=0..255)"
				return $m
			}
			$m.exit = $v
		} else if starts_with($word, "stream=")? {
			$v := replace_first($word, "stream=", "")
			$valid := contains(["stdout", "stderr", "combined"], $v)?
			if !$valid {
				$m.error = "bad stream metadata " ~ $word ~ " (want stdout, stderr, or combined)"
				return $m
			}
			$m.stream = $v
		} else if $word == "nondeterministic" {
			$m.nondeterministic = true
		} else if $word == "norun" {
			$m.norun = true
		} else {
			$m.error = "unknown checker metadata " ~ $word
			return $m
		}
	}
	$m
}

fn .actual($r, $stream) {
	if $stream == "stderr" {
		return $r.err
	}
	if $stream == "combined" {
		if trim($r.out) != "" and trim($r.err) != "" {
			return $r.out ~ "\n" ~ $r.err
		}
		return $r.out ~ $r.err
	}
	$r.out
}

# --- collect (code, expected?, line) triples -----------------------------------
$cases := []
$i := 0
while $i < $n {
	$fence := trim($lines[$i])
	if $fence == "```drang" or starts_with($fence, "```drang ")? {
		$start := $i + 1
		$j := $start
		while $j < $n and trim($lines[$j]) != "```" {
			$j = $j + 1
		}
		$code := join($lines[$start..$j - 1], "\n")
		$metadata := .meta($fence)?
		$k := $j + 1
		while $k < $n and trim($lines[$k]) == "" {
			$k = $k + 1
		}
		if $k < $n and trim($lines[$k]) == "```" {
			$ostart := $k + 1
			$m := $ostart
			while $m < $n and trim($lines[$m]) != "```" {
				$m = $m + 1
			}
			push(
				$cases,
				{
					code: $code,
					expected: join($lines[$ostart..$m - 1], "\n"),
					hasout: true,
					line: $start + 1,
					meta: $metadata
				}
			)?
			$i = $m + 1
		} else {
			push($cases, {code: $code, expected: "", hasout: false, line: $start + 1, meta: $metadata})?
			$i = $j + 1
		}
	} else {
		$i = $i + 1
	}
}
$caseCount := len($cases)?
say($"Checking ${caseCount} drang example blocks in ${doc}")
say("")
$pass := 0
$fail := 0
$nondet := 0
$shell := 0
$norun := 0
$noout := 0
for $c in $cases {
	if $c.meta.error != "" {
		$fail = $fail + 1
		say($"FAIL  ${doc}:${c.line} — ${c.meta.error}")
		next
	}
	if $c.meta.norun or .is_norun($c.code)? {
		$norun = $norun + 1
		next
	}
	if .is_shell($c.code)? {
		$shell = $shell + 1
		next
	}
	write_file($prog, $c.code)?
	$r := capture_all(exe(), "prog.dr", {cwd: $work})  # cwd -> the child sees prog.dr and writes here
	if $r.code != $c.meta.exit {
		$fail = $fail + 1
		say($"FAIL  ${doc}:${c.line} exits ${r.code}, want ${c.meta.exit}")
		if trim($r.out) != "" {
			say("--- actual (stdout) ---")
			say(.norm($r.out))
		}
		if trim($r.err) != "" {
			say("--- actual (stderr) ---")
			say(.norm($r.err))
		}
		say("")
		next
	}
	if $c.meta.nondeterministic {
		$nondet = $nondet + 1
		say($"SKIP  non-deterministic at ${doc}:${c.line}")
		next
	}
	if !$c.hasout {
		$noout = $noout + 1
		$pass = $pass + 1
		next
	}
	$want := .norm($c.expected)
	$got := .norm(.actual($r, $c.meta.stream))
	if $got == $want {
		$pass = $pass + 1
	} else {
		$fail = $fail + 1
		say($"FAIL  ${doc}:${c.line} (exit ${r.code})")
		say("--- code ---")
		say($c.code)
		say("--- expected ---")
		say($want)
		say($"--- actual (${c.meta.stream}) ---")
		say($got)
		say("")
	}
}
rm($work) // true
say("")
say("=== summary ===")
say($"  blocks:            ${caseCount}")
say($"  checked:           ${$pass + $fail}")
say($"  passed:            ${pass}")
say($"  mismatches:        ${fail}")
say($"  non-deterministic: ${nondet} (run, not compared)")
say($"  shell-skipped:     ${shell}")
say($"  norun-skipped:     ${norun} (shown, not run — blocking/display examples)")
say($"  no-output:         ${noout} (exit status checked)")
say("")
if $fail == 0 {
	say("EXAMPLES OK")
	exit(0)
} else {
	say($"EXAMPLES FAILED — ${fail} mismatch(es)")
	exit(1)
}
